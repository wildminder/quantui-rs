/target/
*.gguf
__pycache__/
.workbuddy-ai/
_backup
# Auto-generated workspace backups (hundreds of MB) land in the repo root too,
# not just in _backup/ — ignore them so `git add -A` can't sweep one in.
*.rar
# Phase 11.1: large generated benchmark fixture + criterion HTML reports.
# WP10 exception: tests/bench/bench_small.safetensors is COMMITTED (nightly
# bench needs it with zero setup); only the big generated fixtures stay out.
/tests/bench/*.safetensors
!/tests/bench/bench_small.safetensors
/crates/quant-core/target/
target/criterion/
docs/
# Debug-harness build artifacts (tools/*.exe, *.obj)
tools/*.exe
tools/*.obj
# Phase 8.3 e2e sweep working dir: fixture + outputs are deterministically
# regenerable via tools/gen_sweep_fixture.py — never commit the artifacts.
tools/sweep_e2e/

# dbg example run outputs (crates/quant-core/examples/dbg_*.rs)
crates/quant-core/tmp_*.safetensors
crates/quant-core/tmp_*.safetensors.quant-manifest.json
crates/quant-core/tmp_*.bin
